# Copy to .env for local work. Never commit the real .env — it is gitignored.

# Build target. Anything other than "production" is treated as a preview:
# robots.txt disallows everything, _headers adds X-Robots-Tag: noindex,
# every page gets a noindex meta tag and the analytics beacon is omitted.
SITE_ENV=preview

# Canonical origin. Must be the real domain once it is registered.
# Falls back to https://fix-it-easy.workers.dev when unset.
PUBLIC_SITE_URL=https://fix-it-easy.workers.dev

# Cloudflare Web Analytics beacon token. Cookie-free.
# Left empty in dev and preview — the script tag is only emitted when this is set
# AND SITE_ENV=production.
PUBLIC_CF_BEACON_TOKEN=
