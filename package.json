{
  "name": "fix-it-easy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:content && npm run check:copy && astro check && astro build && npm run emit:deploy && npm run check:production",
    "preview": "astro preview",
    "check:content": "node scripts/check-content-uniqueness.mjs",
    "check:copy": "node scripts/check-no-hardcoded-copy.mjs",
    "check:production": "node scripts/check-production-ready.mjs",
    "emit:deploy": "node scripts/emit-deploy-files.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource-variable/inter": "5.3.0",
    "typescript": "6.0.3",
    "wrangler": "4.123.0",
    "yaml": "2.9.0"
  }
}
