---
/**
 * Appliance artwork for the homepage grid and the service page headers.
 *
 * Drawn inline rather than loaded as image files: eleven cards would otherwise mean eleven
 * extra requests on the page that has to load fastest, and vector artwork sized in the
 * markup cannot shift the layout while it loads. If the client ever supplies photographs,
 * they replace this component behind the same `icon` key in the content files.
 */
import type { ServiceEntry } from '@/lib/site';

type IconKey = ServiceEntry['data']['icon'];

type Props = {
  icon: IconKey;
  class?: string;
};

const { icon, class: className = '' } = Astro.props;

const RED = 'var(--color-red-600)';

const artwork: Record<IconKey, string> = {
  refrigerator: `
    <rect x="15" y="5" width="34" height="54" rx="3.5" fill="#fff" stroke="currentColor" stroke-width="2.6"/>
    <path d="M15 24h34" stroke="currentColor" stroke-width="2.6"/>
    <rect x="20" y="11" width="3.2" height="8" rx="1.6" fill="${RED}"/>
    <rect x="20" y="29" width="3.2" height="11" rx="1.6" fill="${RED}"/>`,

  freezer: `
    <rect x="6" y="17" width="52" height="31" rx="3.5" fill="#fff" stroke="currentColor" stroke-width="2.6"/>
    <path d="M6 26h52" stroke="currentColor" stroke-width="2.6"/>
    <rect x="27" y="20" width="10" height="3.2" rx="1.6" fill="currentColor"/>
    <path d="M32 31v12M27 33.5l10 7M37 33.5l-10 7" stroke="${RED}" stroke-width="2.4" stroke-linecap="round"/>`,

  dryer: `
    <rect x="10" y="6" width="44" height="52" rx="3.5" fill="#fff" stroke="currentColor" stroke-width="2.6"/>
    <path d="M10 19h44" stroke="currentColor" stroke-width="2.6"/>
    <circle cx="32" cy="38" r="13" fill="none" stroke="currentColor" stroke-width="2.6"/>
    <path d="M26.5 33.5a7.5 7.5 0 0 0 11 10" fill="none" stroke="${RED}" stroke-width="2.6" stroke-linecap="round"/>
    <circle cx="17.5" cy="12.5" r="2.2" fill="${RED}"/>`,

  washer: `
    <rect x="10" y="6" width="44" height="52" rx="3.5" fill="#fff" stroke="currentColor" stroke-width="2.6"/>
    <path d="M10 19h44" stroke="currentColor" stroke-width="2.6"/>
    <circle cx="32" cy="38" r="13" fill="none" stroke="currentColor" stroke-width="2.6"/>
    <circle cx="32" cy="38" r="5.5" fill="none" stroke="${RED}" stroke-width="2.6"/>
    <circle cx="17.5" cy="12.5" r="2.2" fill="${RED}"/>`,

  dishwasher: `
    <rect x="10" y="6" width="44" height="52" rx="3.5" fill="#fff" stroke="currentColor" stroke-width="2.6"/>
    <path d="M10 19h44" stroke="currentColor" stroke-width="2.6"/>
    <rect x="16" y="11" width="13" height="3.2" rx="1.6" fill="${RED}"/>
    <path d="M23 27v23M32 27v23M41 27v23" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>`,

  oven: `
    <rect x="10" y="7" width="44" height="50" rx="3.5" fill="#fff" stroke="currentColor" stroke-width="2.6"/>
    <path d="M10 20h44" stroke="currentColor" stroke-width="2.6"/>
    <rect x="16" y="12" width="14" height="3.2" rx="1.6" fill="${RED}"/>
    <rect x="17" y="27" width="30" height="23" rx="2.5" fill="none" stroke="currentColor" stroke-width="2.4"/>`,

  stove: `
    <rect x="8" y="14" width="48" height="44" rx="3.5" fill="#fff" stroke="currentColor" stroke-width="2.6"/>
    <path d="M8 30h48" stroke="currentColor" stroke-width="2.6"/>
    <circle cx="20" cy="22" r="4.2" fill="${RED}"/>
    <circle cx="44" cy="22" r="4.2" fill="none" stroke="currentColor" stroke-width="2.4"/>
    <rect x="16" y="38" width="32" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="2.4"/>`,

  range: `
    <path d="M12 16V8h40v8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/>
    <rect x="8" y="16" width="48" height="42" rx="3.5" fill="#fff" stroke="currentColor" stroke-width="2.6"/>
    <path d="M8 30h48" stroke="currentColor" stroke-width="2.6"/>
    <circle cx="20" cy="23" r="3.8" fill="none" stroke="currentColor" stroke-width="2.4"/>
    <circle cx="44" cy="23" r="3.8" fill="${RED}"/>
    <rect x="16" y="38" width="32" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="2.4"/>`,

  cooktop: `
    <rect x="5" y="13" width="54" height="38" rx="5" fill="#fff" stroke="currentColor" stroke-width="2.6"/>
    <circle cx="21" cy="26" r="6" fill="none" stroke="currentColor" stroke-width="2.4"/>
    <circle cx="43" cy="26" r="6" fill="${RED}"/>
    <circle cx="21" cy="40" r="4.5" fill="none" stroke="currentColor" stroke-width="2.4"/>
    <circle cx="43" cy="40" r="4.5" fill="none" stroke="currentColor" stroke-width="2.4"/>`,

  microwave: `
    <rect x="4" y="16" width="56" height="32" rx="3.5" fill="#fff" stroke="currentColor" stroke-width="2.6"/>
    <rect x="10" y="22" width="30" height="20" rx="2.5" fill="none" stroke="currentColor" stroke-width="2.4"/>
    <circle cx="50" cy="25" r="2.4" fill="${RED}"/>
    <path d="M46 32h8M46 37h8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>`,

  'wine-cooler': `
    <rect x="15" y="5" width="34" height="54" rx="3.5" fill="#fff" stroke="currentColor" stroke-width="2.6"/>
    <path d="M15 27h34M15 43h34" stroke="currentColor" stroke-width="2.4"/>
    <path d="M27 11h10l-1.2 6.4a3.9 3.9 0 0 1-7.6 0z" fill="${RED}"/>
    <path d="M32 17.5v4.5" stroke="${RED}" stroke-width="2.4" stroke-linecap="round"/>`,
};
---

<svg
  class={className}
  viewBox="0 0 64 64"
  width="64"
  height="64"
  fill="none"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={artwork[icon]}
/>
