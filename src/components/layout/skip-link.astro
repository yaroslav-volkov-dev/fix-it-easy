---
type Props = {
  label: string;
  targetId: string;
};

const { label, targetId } = Astro.props;
---

<a
  href={`#${targetId}`}
  class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-control focus:bg-navy-900 focus:px-5 focus:py-3 focus:font-bold focus:text-white"
>
  {label}
</a>
