---
/**
 * Homepage block 4. Two sentences, set large — the contrast is the whole point.
 *
 * The full badge lives here. Of every block on the site this is the one that is both a white
 * band — the ground the mark is drawn for — and a statement about who we are, which is what a
 * seal is for. It also fills the half of the band the two sentences leave empty.
 */
import BrandBadge from '@/components/layout/brand-badge.astro';
import Band from '@/components/ui/band.astro';
import type { SiteCopy } from '@/lib/site';

type Props = {
  brand: SiteCopy['brand'];
  heading: string;
  body: string;
};

const { brand, heading, body } = Astro.props;
const headingId = 'differentiation-heading';
---

<Band tone="light" labelledby={headingId}>
  <div class="flex flex-col items-center gap-10 md:flex-row md:justify-between md:gap-14">
    <div class="measure">
      <h2 id={headingId} class="text-h2 font-black text-grey-500">{heading}</h2>
      <p class="mt-4 text-h2 font-black text-navy-900">{body}</p>
    </div>

    <BrandBadge brand={brand} class="h-44 w-44 shrink-0 sm:h-52 sm:w-52" />
  </div>
</Band>
