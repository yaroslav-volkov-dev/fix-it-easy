---
/**
 * Homepage block 6 — and the only route into the service pages from the body of the site.
 *
 * The labels are the client's own eleven words in the client's order; the pages behind them
 * number eight, because oven, stove, range and cook top all lead to the same combined page.
 * Which label points where is decided in src/content/home/appliances.yaml, not here.
 *
 * The words are stored exactly as the client wrote them, in lower case, and capitalised by
 * CSS — so the content file holds the approved copy and nothing renames it in passing.
 */
import ApplianceIllustration from '@/components/ui/appliance-illustration.astro';
import Band from '@/components/ui/band.astro';

type Card = {
  label: string;
  icon: Parameters<typeof ApplianceIllustration>[0]['icon'];
  service: { id: string };
};

type Props = {
  heading: string;
  intro?: string;
  cards: Card[];
  tone?: 'light' | 'muted';
};

const { heading, intro, cards, tone = 'light' } = Astro.props;
const headingId = 'appliance-grid-heading';
---

<Band tone={tone} labelledby={headingId}>
  <h2 id={headingId} class="text-h2 font-black text-navy-900">{heading}</h2>
  {intro && <p class="measure mt-4 text-lead">{intro}</p>}

  <!--
    One surface per card, and no shadow. The icon used to sit in a grey chip inside the card,
    which spent the card's width on a second frame and left the drawing small; the card is the
    frame, so the appliance can be the size it deserves.

    The lifting drop shadow that replaced the faint hairline solved the wrong problem: a grid
    of eleven soft-shadowed rounded tiles is the exact shape of the look this brand is not.
    The border carries the boundary on its own, and the hover state fills the tile instead of
    floating it, which also reads faster on a page whose whole promise is speed.
  -->
  <!--
    Wrapped and centred rather than a grid, so the short last row sits in the middle instead
    of hanging off the left with a hole on the right.

    Eleven is prime, so no column count divides it evenly: four columns leave one gap, three
    leave one, two leave one. The row will always be short, so the only question is where the
    missing tile shows. Centring reads as deliberate; flush-left with a hole reads as a bug.

    The widths reproduce the grid exactly: each tile is a full row minus the gaps, divided by
    the column count. Full rows therefore still fill edge to edge, and only the short one moves.
  -->
  <ul class="mt-heading-gap flex flex-wrap justify-center gap-3">
    {
      cards.map((card) => (
        <li class="w-[calc(50%-0.375rem)] sm:w-[calc((100%-1.5rem)/3)] lg:w-[calc((100%-2.25rem)/4)]">
          <a
            href={`/services/${card.service.id}/`}
            class="group flex h-full flex-col items-center gap-3.5 rounded-card border border-grey-300 bg-white p-5 text-center transition-colors duration-150 hover:border-navy-900 hover:bg-navy-900"
          >
            <ApplianceIllustration
              icon={card.icon}
              class="h-16 w-16 text-navy-900 transition-colors group-hover:text-white"
            />
            <span class="text-lead font-bold text-navy-900 capitalize group-hover:text-white">
              {card.label}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Band>
