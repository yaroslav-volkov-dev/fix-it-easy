---
/**
 * A heading over a set of short titled paragraphs. Used twice: for a city's local
 * conditions — the section that carries a city page's ranking value — and for a service's
 * common problems. Both are the same shape, so they are the same component.
 *
 * scripts/check-content-uniqueness.mjs refuses to build if two cities end up filling this
 * section with the same words.
 */
import Band from '@/components/ui/band.astro';

type Card = {
  title: string;
  body: string;
};

type Props = {
  heading: string;
  headingId: string;
  cards: Card[];
  tone?: 'light' | 'muted';
};

const { heading, headingId, cards, tone = 'light' } = Astro.props;
---

<Band tone={tone} labelledby={headingId}>
  <h2 id={headingId} class="text-h2 font-black text-navy-900">{heading}</h2>

  <!--
    A rule above each entry, not a card and not a stripe down its side.

    This went through both wrong answers first. A thick coloured border on the left edge is
    decoration pretending to be structure. Wrapping each entry in a filled card fixed the
    separation but turned nine short paragraphs into nine identical boxes, which is the look
    this brand is least allowed to have. A rule on top separates the entries and lines the
    columns up across the grid, so the section reads as a spec sheet rather than a gallery,
    and it is the same device the numbered steps already use.
  -->
  <div class="mt-heading-gap grid gap-x-10 gap-y-8 md:grid-cols-2">
    {
      cards.map((card) => (
        <article class="border-t-2 border-navy-900 pt-4">
          <h3 class="text-h3 font-bold text-navy-900">{card.title}</h3>
          <p class="mt-3 text-body">{card.body}</p>
        </article>
      ))
    }
  </div>
</Band>
