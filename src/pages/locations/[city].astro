---
import AreasServed from '@/components/sections/areas-served.astro';
import CityHero from '@/components/sections/city-hero.astro';
import CtaBand from '@/components/sections/cta-band.astro';
import FaqSection from '@/components/sections/faq-section.astro';
import HowItWorks from '@/components/sections/how-it-works.astro';
import TitledCards from '@/components/sections/titled-cards.astro';
import Breadcrumbs from '@/components/ui/breadcrumbs.astro';
import BaseLayout from '@/layouts/base-layout.astro';
import { interpolate } from '@/lib/interpolate';
import { toE164 } from '@/lib/phone';
import {
  buildBreadcrumbs,
  buildFaqPage,
  buildGraph,
  buildOrganization,
  buildService,
} from '@/lib/schema';
import { absoluteUrl, canonicalUrl } from '@/lib/seo';
import { cityRefs, loadCities, loadHomeCopy, loadSiteCopy } from '@/lib/site';

export const getStaticPaths = async () => {
  const cities = await loadCities();
  return cities.map((city) => ({ params: { city: city.id }, props: { city } }));
};

const { city } = Astro.props;
const { brand, pages } = await loadSiteCopy();
const home = await loadHomeCopy();
const cities = await loadCities();

const tokens = { city: city.data.name, state: city.data.state };
const heroTitle = interpolate(brand.cityHeroTitleTemplate, tokens);

const canonical = canonicalUrl(Astro.site, Astro.url.pathname);
const siteUrl = absoluteUrl(Astro.site, '/');

const crumbs = [
  { label: brand.breadcrumbHomeLabel, href: '/' },
  { label: pages.locationsIndex.title, href: '/locations/' },
  { label: city.data.name },
];

const jsonLd = buildGraph([
  buildOrganization({
    siteUrl,
    name: brand.name,
    logoUrl: absoluteUrl(Astro.site, '/logo.png'),
    telephone: toE164(brand.phone),
    cities: cityRefs(cities),
  }),
  buildService({
    siteUrl,
    name: heroTitle,
    serviceType: brand.tagline,
    description: city.data.metaDescription,
    url: canonical,
    cities: cityRefs([city]),
  }),
  buildFaqPage(city.data.faq),
  buildBreadcrumbs([
    { name: brand.breadcrumbHomeLabel, url: absoluteUrl(Astro.site, '/') },
    { name: pages.locationsIndex.title, url: absoluteUrl(Astro.site, '/locations/') },
    { name: city.data.name, url: canonical },
  ]),
]);
---

<BaseLayout title={city.data.metaTitle} description={city.data.metaDescription} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} ariaLabel={brand.breadcrumbAriaLabel} />

  <CityHero
    title={heroTitle}
    intro={city.data.heroIntro}
    ctaLabel={home.hero.cta.label}
    phone={brand.phone}
  />

  <TitledCards
    heading={interpolate(brand.cityConditionsHeadingTemplate, tokens)}
    headingId="local-conditions-heading"
    cards={city.data.localConditions}
  />

  <HowItWorks heading={home.howItWorks.heading} steps={home.howItWorks.steps} tone="muted" />

  <AreasServed
    heading={interpolate(brand.cityAreasHeadingTemplate, tokens)}
    neighborhoodsLabel={brand.cityNeighborhoodsLabel}
    nearbyLabel={brand.cityNearbyLabel}
    neighborhoods={city.data.neighborhoods}
    nearbyCities={city.data.nearbyCities}
  />

  <FaqSection heading={interpolate(brand.cityFaqHeadingTemplate, tokens)} items={city.data.faq} />

  <CtaBand
    heading={home.ctaBand.heading}
    body={home.ctaBand.body}
    ctaLabel={home.ctaBand.cta.label}
    phone={brand.phone}
  />
</BaseLayout>
