---
/**
 * Served by Cloudflare for any unknown path — wrangler.jsonc sets
 * assets.not_found_handling to "404-page", which points at this file's output.
 */
import ApplianceGrid from '@/components/sections/appliance-grid.astro';
import ServiceAreas from '@/components/sections/service-areas.astro';
import BaseLayout from '@/layouts/base-layout.astro';
import CallButton from '@/components/ui/call-button.astro';
import { toE164 } from '@/lib/phone';
import { buildGraph, buildOrganization } from '@/lib/schema';
import { absoluteUrl } from '@/lib/seo';
import { cityRefs, loadCities, loadHomeCopy, loadSiteCopy } from '@/lib/site';

const { brand, pages } = await loadSiteCopy();
const home = await loadHomeCopy();
const cities = await loadCities();

const copy = pages.notFound;

const jsonLd = buildGraph([
  buildOrganization({
    siteUrl: absoluteUrl(Astro.site, '/'),
    name: brand.name,
    logoUrl: absoluteUrl(Astro.site, '/logo.png'),
    telephone: toE164(brand.phone),
    cities: cityRefs(cities),
  }),
]);
---

<BaseLayout title={copy.metaTitle} description={copy.body} jsonLd={jsonLd} noindex>
  <section class="band-dark surface-hero py-band text-grey-200">
    <div class="container-page">
      <h1 class="measure text-hero font-black text-white">{copy.title}</h1>
      <p class="measure mt-6 text-lead">{copy.body}</p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <CallButton phone={brand.phone} label={home.ctaBand.cta.label} variant="onDark" size="lg" />
        <a href="/" class="font-bold text-white underline underline-offset-4 hover:text-red-400">
          {copy.backLabel}
        </a>
      </div>
    </div>
  </section>

  <ApplianceGrid heading={home.appliances.heading} cards={home.appliances.cards} />

  <ServiceAreas
    heading={home.serviceAreas.heading}
    allLocationsLabel={home.serviceAreas.allLocationsLabel}
    cities={cities}
  />
</BaseLayout>
