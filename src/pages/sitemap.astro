---
/**
 * Human-readable site map. The machine-readable one lives at /sitemap-index.xml and is
 * generated by @astrojs/sitemap; this page exists for visitors and for crawlers that
 * follow links rather than XML.
 */
import Band from '@/components/ui/band.astro';
import Breadcrumbs from '@/components/ui/breadcrumbs.astro';
import BaseLayout from '@/layouts/base-layout.astro';
import { toE164 } from '@/lib/phone';
import { buildBreadcrumbs, buildGraph, buildOrganization } from '@/lib/schema';
import { absoluteUrl, canonicalUrl } from '@/lib/seo';
import { cityRefs, loadCities, loadServices, loadSiteCopy } from '@/lib/site';

const { brand, navigation, legal, pages } = await loadSiteCopy();
const services = await loadServices();
const cities = await loadCities();

const copy = pages.humanSitemap;
const canonical = canonicalUrl(Astro.site, Astro.url.pathname);

const sections = [
  {
    heading: copy.sections.main,
    links: [
      { label: brand.breadcrumbHomeLabel, href: '/' },
      ...navigation.main,
      { label: copy.title, href: '/sitemap/' },
    ],
  },
  {
    heading: copy.sections.services,
    links: services.map((service) => ({
      label: service.data.name,
      href: `/services/${service.id}/`,
    })),
  },
  {
    heading: copy.sections.locations,
    links: cities.map((city) => ({
      label: `${city.data.name}, ${city.data.state}`,
      href: `/locations/${city.id}/`,
    })),
  },
  {
    heading: copy.sections.legal,
    links: legal.pages.map((page) => ({ label: page.title, href: `/${page.slug}/` })),
  },
];

const jsonLd = buildGraph([
  buildOrganization({
    siteUrl: absoluteUrl(Astro.site, '/'),
    name: brand.name,
    logoUrl: absoluteUrl(Astro.site, '/logo.png'),
    telephone: toE164(brand.phone),
    cities: cityRefs(cities),
  }),
  buildBreadcrumbs([
    { name: brand.breadcrumbHomeLabel, url: absoluteUrl(Astro.site, '/') },
    { name: copy.title, url: canonical },
  ]),
]);
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription} jsonLd={jsonLd}>
  <Breadcrumbs
    items={[{ label: brand.breadcrumbHomeLabel, href: '/' }, { label: copy.title }]}
    ariaLabel={brand.breadcrumbAriaLabel}
  />

  <Band tone="light">
    <h1 class="measure text-hero font-black text-navy-900">{copy.title}</h1>
    <p class="measure mt-5 text-lead">{copy.intro}</p>

    <div class="mt-heading-gap grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        sections.map((section) => (
          <nav aria-label={section.heading}>
            <h2 class="eyebrow text-grey-500">{section.heading}</h2>
            <ul class="mt-4 grid gap-2.5">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="font-semibold text-navy-900 underline-offset-4 hover:text-red-600 hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </Band>
</BaseLayout>
